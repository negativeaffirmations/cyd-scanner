# Claude Code personal/local settings (may hold machine-specific paths)
.claude/settings.local.json
# Local-only cross-project bridge instructions: holds a machine path + may reference sensitive
# logs/serial output. Never commit. (See the file itself; CLAUDE.md only cites its name.)
REMOTE.md
scanlogs

# Captured RF data — may contain bystander (human) identifiers + GPS.
# Keep real captures in untracked folders; never commit them to the public repo.
/logs/
scanlog*.csv
*.pcap
*.pcapng
*.kml
*.jsonl
sessions/
# User's own device whitelist (SD copy / any local export) — personal identifiers.
/whitelist.csv
whitelist*.csv

# Python bytecode cache
__pycache__/
*.pyc

# Node / Sass toolchain for the web app (webapp/style.css IS committed; node_modules is not)
node_modules/
webapp/*.css.map

# Ignore Adobe files
*.psd
*.ai
# Device pairing QR codes -- each encodes a scanner's secret phone-link key. Never commit.
qr-codes/
