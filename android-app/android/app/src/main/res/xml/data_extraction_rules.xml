<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device transfer of app data: it holds scanner keys and cached scan logs, which
     can include bystanders' device identifiers with GPS (CLAUDE.md "Scope / ethics / privacy"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
