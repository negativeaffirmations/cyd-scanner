<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides Capacitor's layout of the same name (node_modules/@capacitor/android) to use CfloWebView, which keeps the
     page running in the background while a scanner is connected (docs/android-app.md "Stage 2"). Keep the id "webview":
     Capacitor's Bridge looks it up. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.getcapacitor.BridgeActivity"
    >

    <io.github.negativeaffirmations.cointelflo.CfloWebView
        android:id="@+id/webview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
